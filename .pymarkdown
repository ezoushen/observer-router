{
  // The Markdown rules for this repository (pymarkdownlnt reads this file from the repo root).
  // Run them with scripts/lint-md.
  "extensions": {
    // Without it, table rows are checked as prose and trip the line-length rule.
    "markdown-tables": { "enabled": true }
  },
  "plugins": {
    "md013": {
      "line_length": 100,
      "heading_line_length": 100,
      "code_block_line_length": 120,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "strict": false
    },
    "md024": { "siblings_only": true },
    // Table pipe alignment is not a convention of this repository.
    "md060": { "enabled": false }
  }
}
